# Scenario: V0 has one predicate and puts two positives and two negatives on the same side,
# so they share one equivalence class and collide.
objects 8
add half 0 1 4 5
pos 0 1
neg 4 5

status
explain

# Three candidate predicates, each separating a different colliding pair.
score p_left  0
score p_right 4
score p_diag  0 4

# Adopt p_left: two pairs remain.
add p_left 0
status
explain

# Adopt p_right: one pair remains.
add p_right 4
status
explain

# A third predicate is needed to separate the last pair.
add p_top 1 5
status
explain
