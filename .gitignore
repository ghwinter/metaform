# Default deny. Everything is ignored unless it is a directory, or is a file,
# named in the allow list below. Adding a source file to an allowed directory
# needs no edit here; adding a new directory does.
*
!*/

# ---------------------------------------------------------------------------
# Allow list: what this repository is. Source code, the formalization, the
# paper, the manual under `docs/`, and the four documents that say what the code
# claims.
#
# Nothing else is tracked. The working tree is deliberately bigger than this:
# gates, experiment runs, notes and agent configuration all live beside the
# code and are used by it, but they are inputs and outputs of a session rather
# than the thing being versioned. A clone rebuilds them from the code; a diff
# in them is not a change to the product.
# ---------------------------------------------------------------------------
!/.gitattributes
!/Cargo.lock
!/Cargo.toml
!/.gitignore
!/LICENSE-APACHE
!/LICENSE-MIT
!/README.md
!/README.zh.md
!/CHARTER.md
!/CHARTER.zh.md
!/environment.json
!/LAYOUT.tsv
!/crates/**
!/paper/**
!/proofs/**
!/docs/**

# ---------------------------------------------------------------------------
# Working directories that are never tracked. The default deny already covers
# them; they are listed so that the decision is written down rather than
# inferred from the absence of an exception.
# ---------------------------------------------------------------------------

# Gate scripts, experiment runs and the evidence they produce. Run locally,
# cited by path in RESULTS, versioned by the commit that runs them.
experiments/
scripts/

# Agent configuration: skills, MCP wiring, session memory.
.dsh/
.workbuddy/

# Notes and design drafts; the offline corpus is other people's material.
/notes/
research/
.library/
.local/
.repo/

# Model weights and the local inference runtime. Downloaded, not built: 2.5 GB of weights and a
# prebuilt llama.cpp. They are what the experiments are run against, so they are named here rather
# than buried in tmp -- tmp is scratch, this is a dependency of the measurements.
/models/

# Demo state written by `metaform init` at the repository root.
.metaform/

# Release staging and metered-run output.
dist/
tmp/

# ---------------------------------------------------------------------------
# Ignored even inside an allowed directory: build products, machine-local
# configuration, generated files. A later match wins.
# ---------------------------------------------------------------------------
/target/
crates/metaform/target/
crates/*/target/
crates/*/Cargo.lock

proofs/.lake/
proofs/lakefile.toml
proofs/lake-manifest.json
proofs/lean-toolchain

**/__pycache__/
*.pyc
*.pdf
*.aux
*.log
*.out
*.toc
*.png
crates/metaform/last-test.log
crates/*/last-test.log
proofs/last-check.log
